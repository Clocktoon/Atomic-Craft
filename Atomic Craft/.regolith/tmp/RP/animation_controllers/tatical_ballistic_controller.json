{
    "format_version": "1.26.0",
    "animation_controllers": {
        "controller.animation.ballistic": {
            "initial_state": "flying",
            "states": {
                "flying": {
                    "animations": [
                        "rotate"
                    ],
                    "transitions": [
                        {
                            "sitting": "!query.property('atomic:blastoff')"
                        }
                    ]
                },
                "sitting": {
                    "animations": [
                        "sit"
                    ],
                    "transitions": [
                        {
                            "flying": "query.property('atomic:blastoff')"
                        }
                    ]
                }
            }
        }
    }
}