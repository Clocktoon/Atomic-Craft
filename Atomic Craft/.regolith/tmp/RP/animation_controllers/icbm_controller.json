{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.icbm": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idleny"
                    ],
                    "transitions": [
                        {
                            "flying": "query.property('atomic:blastoff')"
                        }
                    ]
                },
                "flying": {
                    "animations": [
                        "flying"
                    ],
                    "transitions": [
                        {
                            "idle": "!query.property('atomic:blastoff')"
                        },
                        {
                            "un": "query.property('atomic:warphase')"
                        }
                    ]
                },
                "un": {
                    "animations": [
                        "unleash"
                    ],
                    "transitions": [
                        {
                            "flying": "query.all_animations_finished == 1.0;"
                        }
                    ]
                }
            }
        } 
    }
}