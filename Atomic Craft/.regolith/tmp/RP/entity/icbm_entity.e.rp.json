{
  "format_version": "1.21.120",
  "minecraft:client_entity": {
    "description": {
      "identifier": "atomic:icbm",
      "render_controllers": ["controller.render.icbm_entity"],
      "geometry": {
        "default": "geometry.icbm"
      },
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/icmb_texture"
      },
      "particle_effects": {
        "icbm_trail_partcc": "atomic:icbm_trail_partcc",
        "icbmunleash": "atomic:icbmunleash"
      },
      "animations": {
        "idleny": "animation.icbm.idle",
        "flying": "animation.icbm.fly",
        "unleash": "animation.icbm.unleash",
        "con": "controller.animation.icbm"
      },
      "scripts": {
        "animate": ["con"],
        "initialize": ["variable.current_yaw=0;", "variable.current_pitch=0;"],

        "pre_animation": [
          "v.current_yaw = v.current_yaw ? v.current_yaw : q.property('atomic:yaw');",
          "v.current_pitch = v.current_pitch ? v.current_pitch : q.property('atomic:pitch');",

          "v.current_yaw = math.lerprotate(v.current_yaw, q.property('atomic:yaw'), q.delta_time * 10);",
          "v.current_pitch = math.lerprotate(v.current_pitch, q.property('atomic:pitch'), q.delta_time * 10);"
        ]
      }
    }
  }
}
