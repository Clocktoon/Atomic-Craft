{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "atomic:nukepart",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/smokeeey"
			}
		},
		"curves": {
			"variable.nuclearcurve": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [-0.1, -0.63, 0.73, -0.24]
			},
			"variable.sizecurve": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [2.14, 0.65, 2.33]
			}
		},
		"events": {
			"mushroom": {
				"particle_effect": {
					"effect": "atomic:capcloud",
					"type": "emitter"
				}
			},
			"ring": {
				"particle_effect": {
					"effect": "atomic:ring3",
					"type": "emitter"
				}
			},
			"ash": {
				"particle_effect": {
					"effect": "atomic:ashcloud2",
					"type": "emitter"
				}
			},
			"nukecloudring": {
				"particle_effect": {
					"effect": "atomic:nukering",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": "300 + variable.emitter_lifetime"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 200
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["mushroom", "ring", "ash", "nukecloudring"]
			},
			"minecraft:emitter_shape_disc": {
				"offset": [1, 0, 1],
				"radius": 3,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 17
			},
			"minecraft:particle_initial_speed": "math.random_integer(1,2)",
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.cos(variable.particle_random_1 * 360) - variable.nuclearcurve", "math.min(-30 + variable.particle_age * 3.2, 30)", "math.sin(variable.particle_random_1 * 360) + variable.nuclearcurve"]
			},
			"minecraft:particle_kill_plane": [0, 0, 1, 1.1],
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.sizecurve", "variable.sizecurve"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [7, 0],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.36": "#FF525252",
						"1.68": "#FFBC853F",
						"2.94": "#FF736C6C"
					}
				}
			}
		}
	}
}