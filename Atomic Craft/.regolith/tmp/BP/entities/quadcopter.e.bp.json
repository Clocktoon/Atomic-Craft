{
  "format_version": "1.26.60",
  "minecraft:entity": {
    "description": {
      "identifier": "atomic:quadcopter",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "atomic:drone_mode": {
          "type": "enum",
          "default": "fpvmode",
          "values": ["fpvmode","controllermode"],
          "client_sync": true
        },
        "atomic:drone_on": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "atomic:fpv_group" : {
        "minecraft:physics": {
          "has_collision": true,
          "has_gravity": false
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "test": "has_damage",
                  "subject": "self",
                  "value": "fall"
                }
              },
              "deals_damage": "no"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:collision_box": {
        "width": 1,
        "height": 0.3
      },
      "minecraft:movement": {
        "value": 1,
        "max": 1
      },
      "minecraft:movement.hover": {
        "max_turn": 30
      },
      "minecraft:navigation.hover": {
        "avoid_damage_blocks": false,
        "avoid_portals": false,
        "avoid_sun": false,
        "avoid_water": false,
        "can_break_doors": false,
        "can_jump": true,
        "can_path_from_air": false,
        "can_path_over_lava": false,
        "can_path_over_water": false,
        "can_sink": true,
        "can_swim": false,
        "can_walk": true,
        "can_walk_in_lava": false,
        "is_amphibious": false
      },      
      "minecraft:behavior.float": {
        "priority": 7
      },
      "minecraft:jump.dynamic": {
        "regular_skip_data": {
            "height": 0.1
        }
      },
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": true
      },
      "minecraft:type_family": {
        "family": [
            "atomic:drone"
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {}
        ]
      },
      "minecraft:can_fly": {
        
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 1,
            "height": 0.3,
            "pivot": [0, 0.15, 0]
          }
        ]
      }
    },
    "events": {
      "atomic:fpv": {
        "add": {
          "component_groups": [
            "atomic:fpv_group"
          ]
        }
      },
      "atomic:fpv_off": {
        "remove": {
          "component_groups": [
            "atomic:fpv_group"
          ]
        }
      }
    }
  }
}
