{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "atomic:ballistic_missile",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "atomic:yaw": {
          "type": "float",
          "default": 0.0,
          "range": [-360.0, 360.0],
          "client_sync": true
        },
        "atomic:pitch": {
          "type": "float",
          "default": 0.0,
          "range": [-90.0, 90.0],
          "client_sync": true
        },
        "atomic:blastoff": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "atomic:exploded": {
          "type": "bool",
          "client_sync": true,
          "default": false
        },
        "atomic:pay": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "atomic:launching": {
          "type": "bool",
          "client_sync": true,
          "default": false
        }
      }
    },
    "component_groups": {
      "atomic:explode": {
        "minecraft:explode": {
          "breaks_blocks": true,
          "causes_fire": false,
          "destroy_affected_by_griefing": false,
          "fire_affected_by_griefing": false,
          "fuse_lit": true,
          "max_resistance": 0,
          "power": 16
        }
      },
      "atomic:offf": {
        "minecraft:health": {
          "value": 100
        }
      },
      "atomic:on": {
        "minecraft:attack": {
          "damage": 0
        },
        "minecraft:follow_range": {
          "value": 10000
        },
        "minecraft:physics": {
          "has_collision": true,
          "has_gravity": false
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["bmissile"]
      },
      "minecraft:health": {
        "value": 100
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "Open Missile GUI"
          }
        ]
      },
      "minecraft:collision_box": {
        "height": 6,
        "width": 1
      },
      "minecraft:target_nearby_sensor": {
        "must_see": false,
        "inside_range": 2.0,
        "outside_range": 4.0,
        "on_inside_range": {
          "event": "atomic:exposi",
          "target": "self"
        },
        "on_outside_range": {
          "event": "atomic:off",
          "target": "self"
        }
      },
      "minecraft:ignore_cannot_be_attacked": {},
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": true
      },
      "minecraft:can_fly": {},
      "minecraft:jump.dynamic": {},
      "minecraft:tick_world": {
        "never_despawn": true,
        "radius": 2
      }
    },
    "events": {
      "atomic:exposi": {
        "add": {
          "component_groups": ["atomic:explode"]
        },
        "set_property": {
          "atomic:exploded": true
        }
      },
      "atomic:off": {
        "add": {
          "component_groups": ["atomic:offf"]
        }
      },
      "atomic:onn": {
        "add": {
          "component_groups": ["atomic:on"]
        }
      }
    }
  }
}
