{
  "include": [
    "src"
  ],
  "compilerOptions": {
    "module": "es2022",
    "target": "es2024",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "../../BP/scripts",
    "strict": true,
    "noLib": true,
    "types": [
      "@bedrock-apis/env-types"
    ],
    "noEmit": false
  }
}
