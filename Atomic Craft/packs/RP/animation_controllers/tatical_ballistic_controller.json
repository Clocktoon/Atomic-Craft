{
  "format_version": "1.26.0",
  "animation_controllers": {
    "controller.animation.ballistic": {
      "initial_state": "flying",
      "states": {
        "flying": {
          "animations": ["rotate"],
          "transitions": [
            { 
				"sitting": "!query.property('atomic:blastoff')" 
			},
            { 
				"payload": "query.property('atomic:pay')" 
			},
            { 
				"launch": "query.property('atomic:launching')" 
			}
          ]
        },
        "sitting": {
          "animations": ["sit"],
          "transitions": [
			{ 
			"flying": "query.property('atomic:blastoff')" 
			},
			{
				"launch": "query.property('atomic:launching')"
			}
		]
        },
        "payload": {
          "animations": ["paid"],
          "transitions": [
            {
              "flying": "!query.property('atomic:pay')"
            },
			{
				"launch": "query.property('atomic:launching') && !query.property('atomic:pay')"
			}
          ]
        },
        "launch": {
          "animations": ["launch"],
          "transitions": [
            {
              "flying": "!query.property('atomic:launching')"
            },
            {
              "sitting": "!query.property('atomic:launching') && !query.property('atomic:blastoff')"
            },
            {
              "payload": "query.property('atomic:pay')"
            }
          ]
        }
      }
    }
  }
}
