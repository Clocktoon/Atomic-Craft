{
    "format_version": "1.26.0",
    "animation_controllers": {
        "controller.animation.quadcopter": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        {
                            "fly": "!query.is_on_ground && query.property('atomic:drone_on')"
                        }
                    ]
                },
                "fly": {
                    "animations": [
                        "fly"
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground"
                        }
                    ]
                }
            }
        }
    }
}