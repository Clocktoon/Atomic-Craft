{
    "format_version": "1.26.0",
    "animation_controllers": {
        "controller.animation.anti_missile": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        {
                            "move": "query.ground_speed"
                        }
                    ]
                },
                "move": {
                    "animations": [
                        "move"
                    ],
                    "transitions": [
                        {
                            "idle": "!q.ground_speed"
                        }
                    ]
                }
            }
        } 
    }
}